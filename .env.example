# Copy this file to .env.local for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Anthropic Console → API Keys (keep this secret; never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=sk-ant-...

# Optional
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_LIMIT_PER_WINDOW=10
AI_LIMIT_WINDOW_HOURS=3
